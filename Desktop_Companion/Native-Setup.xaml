<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ambient Workspace · Chrome 연결 등록" Width="650" Height="620" MinWidth="580" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#141A24" Foreground="#EDF3FF" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="#D7E6FF"/><Setter Property="Foreground" Value="#122039"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="#222D3F"/><Setter Property="Foreground" Value="#F3F7FF"/><Setter Property="BorderBrush" Value="#41516A"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Chrome과 Desktop을 연결합니다" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock Text="Windows 연결 1단계: 아래 등록 버튼을 누르면 현재 Windows 사용자의 연결 경로를 레지스트리에 저장합니다. 등록 후 이 폴더의 Desktop을 실행하고 Chrome 팝업에서 Windows 연결을 누르세요." Foreground="#B7C7E3" Margin="0,0,0,18"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="현재 Desktop 폴더" Foreground="#9FB6D9" Margin="0,0,0,6"/>
      <TextBox x:Name="FolderText" IsReadOnly="True" FontSize="12"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,17">
      <TextBlock Text="Chrome 확장 ID" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBox x:Name="ExtensionIdText" AutomationProperties.Name="Chrome 확장 ID" FontFamily="Consolas"/>
      <TextBlock Text="제품의 고정 공개 ID를 자동으로 채웠습니다. Chrome 확장 목록의 Ambient Workspace ID와 일치하는지 확인하세요. 기존 ID가 다르면 이전 확장 설정 준비를 사용하세요." Foreground="#AFC1DF" FontSize="12" Margin="0,7,0,0"/>
    </StackPanel>
    <WrapPanel Grid.Row="3">
      <Button x:Name="InstallButton" Content="처음 등록"/>
      <Button x:Name="RepairButton" Content="이 폴더로 재등록"/>
      <Button x:Name="InspectButton" Content="등록 확인"/>
      <Button x:Name="RecoverButton" Content="실패 이전으로 복구"/>
      <Button x:Name="RemoveButton" Content="등록 해제"/>
      <Button x:Name="MigrationButton" Content="이전 확장 설정 준비"/>
    </WrapPanel>
    <Border Grid.Row="4" Background="#1C2636" Padding="14" Margin="0,8,0,12" CornerRadius="6" MinHeight="100">
      <TextBlock x:Name="StatusText" Text="공개 ID를 확인한 뒤 처음 등록을 누르세요. 업데이트·폴더 이동 후에는 이 폴더로 재등록을 선택하세요. 이 버튼을 누를 때만 등록을 변경합니다." Foreground="#C5D6F2"/>
    </Border>
    <DockPanel Grid.Row="5" LastChildFill="False">
      <TextBlock Text="설정·페어링 키·백업은 삭제하거나 초기화하지 않습니다." Foreground="#AFC1DF" FontSize="12" VerticalAlignment="Center" Width="420"/>
      <Button x:Name="CloseButton" Content="닫기" DockPanel.Dock="Right" Margin="0"/>
    </DockPanel>
  </Grid>
  </ScrollViewer>
</Window>
