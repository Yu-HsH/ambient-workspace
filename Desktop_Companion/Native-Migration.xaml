<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ambient Workspace · 기존 확장 설정 이전" Width="710" Height="740" MinWidth="610" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#141A24" Foreground="#EDF3FF" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="#222D3F"/><Setter Property="Foreground" Value="#F3F7FF"/><Setter Property="BorderBrush" Value="#41516A"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="#D7E6FF"/><Setter Property="Foreground" Value="#122039"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25">
    <TextBlock Text="기존 Chrome 설정을 안전한 복사본으로 이전" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="원본 Chrome 프로필·기존 확장 코드는 변경하거나 실행하지 않습니다. 기존 Chrome을 모두 종료한 뒤 해당 프로필의 확장 설정만 새 개인 프로필에 복사합니다." Foreground="#B7C7E3"/>
    <TextBlock Text="1. 기존 Chrome 프로필 폴더와 예전 확장 ID" FontWeight="SemiBold"/>
    <TextBox x:Name="SourceProfileText" AutomationProperties.Name="기존 Chrome 프로필 폴더"/>
    <Button x:Name="BrowseProfileButton" Content="프로필 폴더 선택" HorizontalAlignment="Left"/>
    <TextBox x:Name="OldExtensionIdText" AutomationProperties.Name="예전 확장 ID" FontFamily="Consolas"/>
    <TextBlock Text="Chrome의 chrome://version → 프로필 경로와 chrome://extensions → 예전 확장 ID를 미리 확인하세요. Default 또는 Profile 1 같은 프로필 폴더를 선택합니다." Foreground="#B7C7E3" FontSize="12"/>
    <WrapPanel><Button x:Name="PrepareMigrationButton" Content="복사본 준비"/><Button x:Name="ResumeMigrationButton" Content="기존 준비 기록 열기"/></WrapPanel>
    <TextBlock Text="2. 별도 Chrome에서 신뢰 가능한 도우미 로드" FontWeight="SemiBold" Margin="0,10,0,9"/>
    <TextBlock Text="아래 경로를 복사한 뒤 ‘도우미 Chrome 열기’를 누르세요. 개발자 모드 → 압축해제된 확장 프로그램 로드에서 이 폴더를 선택합니다. 도우미가 복사본의 설정을 개인 백업으로 저장합니다." Foreground="#B7C7E3"/>
    <TextBox x:Name="HelperFolderText" IsReadOnly="True" AutomationProperties.Name="도우미 확장 폴더" FontSize="12"/>
    <WrapPanel><Button x:Name="CopyHelperButton" Content="도우미 폴더 복사"/><Button x:Name="OpenHelperChromeButton" Content="도우미 Chrome 열기"/></WrapPanel>
    <TextBlock Text="3. 백업 확인 후 새 확장에서 명시적으로 복원" FontWeight="SemiBold" Margin="0,10,0,9"/>
    <TextBlock Text="도우미가 저장 완료를 표시하면 별도 Chrome을 종료하고 ‘백업 확인·이전 완료’를 누르세요. 새 확장의 Windows 연결 → 백업 목록 읽기에서 복원합니다. 현재 확장 설정은 복원 직전에 별도 백업합니다." Foreground="#B7C7E3"/>
    <WrapPanel><Button x:Name="CompleteMigrationButton" Content="백업 확인·이전 완료"/><Button x:Name="RemoveMigrationButton" Content="임시 등록만 해제"/></WrapPanel>
    <Border Background="#1C2636" Padding="13" Margin="0,6,0,12" CornerRadius="6" MinHeight="90"><TextBlock x:Name="MigrationStatusText" Text="아직 복사하거나 등록하지 않았습니다. 원본 프로필·Desktop 설정·키는 보존됩니다." Margin="0"/></Border>
    <Button x:Name="CloseMigrationButton" Content="닫기" HorizontalAlignment="Right"/>
  </StackPanel></ScrollViewer>
</Window>
