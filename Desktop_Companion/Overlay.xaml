<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambient Workspace Desktop — v0.8.3"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        Width="800" Height="540">
  <Grid>
    <!-- Independently protected image plane, BELOW the RGB glow plane. -->
    <!-- The previous frame fades out under the new frame to soften hard cuts. -->
    <Image x:Name="VideoWashPrev" Width="800" Height="540" Opacity="0"
           Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"
           RenderOptions.BitmapScalingMode="LowQuality">
      <Image.Effect><BlurEffect Radius="17" /></Image.Effect>
    </Image>
    <Image x:Name="VideoWash" Width="800" Height="540" Opacity="0.58"
           Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"
           RenderOptions.BitmapScalingMode="LowQuality">
      <Image.OpacityMask>
        <!-- Three editable stops preserve an entirely transparent reading center. -->
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.72" RadiusY="0.84">
          <GradientStop Color="#00000000" Offset="0" />
          <GradientStop Color="#00000000" Offset="0.24" />
          <GradientStop Color="#78FFFFFF" Offset="0.47" />
          <GradientStop Color="#EAFFFFFF" Offset="0.76" />
          <GradientStop Color="#FFFFFFFF" Offset="1" />
        </RadialGradientBrush>
      </Image.OpacityMask>
      <Image.Effect><BlurEffect xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Radius="17" /></Image.Effect>
    </Image>
    <Canvas x:Name="AmbientSurface" Background="Transparent" ClipToBounds="True" IsHitTestVisible="False">
    <Canvas.OpacityMask>
      <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.62" RadiusY="0.72">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.43" />
        <GradientStop Color="#65FFFFFF" Offset="0.68" />
        <GradientStop Color="#D9FFFFFF" Offset="0.88" />
        <GradientStop Color="#FFFFFFFF" Offset="1" />
      </RadialGradientBrush>
    </Canvas.OpacityMask>
    <!-- Broad side washes and centered glows replace corner-heavy lighting. -->
    <Rectangle x:Name="EdgeLeft" Width="270" Height="540" IsHitTestVisible="False" />
    <Rectangle x:Name="EdgeRight" Width="270" Height="540" IsHitTestVisible="False" />
    <Rectangle x:Name="EdgeBottom" Width="800" Height="170" IsHitTestVisible="False" />
    <Ellipse x:Name="GlowLeft" Width="650" Height="740" IsHitTestVisible="False" />
    <Ellipse x:Name="GlowRight" Width="650" Height="740" IsHitTestVisible="False" />
    <Ellipse x:Name="GlowBottom" Width="550" Height="550" IsHitTestVisible="False" />
    </Canvas>
    <!-- Diagnostic border is deliberately OUTSIDE the fade mask. -->
    <Border x:Name="DebugBorder" BorderBrush="#FFFF33CC" BorderThickness="7" IsHitTestVisible="False" Visibility="Collapsed"/>
  </Grid>
</Window>
