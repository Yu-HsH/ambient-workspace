<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ambient Workspace · Desktop 설정" Width="920" Height="760" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" FontFamily="맑은 고딕, Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
      <Setter Property="Margin" Value="0,6,0,12"/>
      <Setter Property="LineHeight" Value="22"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,6,0,15"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,6,0,12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,8,0,12"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,4,8,4"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="MinWidth" Value="148"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Padding" Value="20,16,12,0"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ScrollViewer x:Name="HeaderScroll" Padding="0" Margin="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </ScrollViewer>
              <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" CornerRadius="8">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabNavigation="Local"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Desktop 설정" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Ambient Workspace v1.0 · 효과와 연결을 한곳에서 조절합니다." Margin="0,5,0,0"/>
    </StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" Padding="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Desktop 설정 영역">
      <TabItem Header="일반">
        <ScrollViewer>
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="사용과 현재 상태" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="DesktopEnabledCheck" Content="Desktop 효과 전체 사용" AutomationProperties.Name="Desktop 효과 전체 사용"/>
                <CheckBox x:Name="PauseCheck" Content="Desktop 효과 일시정지" AutomationProperties.Name="Desktop 효과 일시정지"/>
                <TextBlock Text="변경한 값은 아래 ‘적용 및 저장’을 누르면 반영됩니다. 일시정지는 Desktop 효과에만 적용됩니다." Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="현재 표시" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="DisplayStatusText" Text="상태 확인 대기" Style="{StaticResource Hint}"/>
                <TextBlock x:Name="OutputStatusText" Text="상태 확인 대기" Style="{StaticResource Hint}"/>
                <Button x:Name="RefreshStatusButton" Content="상태 새로 고침 (_R)" HorizontalAlignment="Left"/>
                <TextBlock x:Name="StatusTimeText" Text="상태 확인 시점" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="RGB 조명">
        <ScrollViewer>
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="RGB 조명" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="RgbEnabledCheck" Content="RGB 조명 사용" AutomationProperties.Name="RGB 조명 사용"/>
                <TextBlock Text="Chrome 색상을 수신하면 해당 색상을 사용하고, 수신이 없으면 기본 팔레트를 표시합니다." Style="{StaticResource Hint}"/>
                <TextBlock Text="기본 팔레트" FontWeight="SemiBold"/>
                <ComboBox x:Name="PaletteCombo" AutomationProperties.Name="기본 팔레트">
                  <ComboBoxItem Content="새벽 · 라벤더 / 청록" Tag="dawn"/>
                  <ComboBoxItem Content="숲 · 비취 / 올리브" Tag="forest"/>
                  <ComboBoxItem Content="노을 · 호박 / 장미" Tag="sunset"/>
                  <ComboBoxItem Content="바다 · 파랑 / 청록" Tag="ocean"/>
                  <ComboBoxItem Content="오로라 · 아이스 / 민트" Tag="aurora"/>
                </ComboBox>
                <TextBlock Text="기본 밝기" Style="{StaticResource Hint}"/>
                <TextBlock x:Name="BrightnessValue" FontWeight="SemiBold"/>
                <Slider x:Name="BrightnessSlider" Minimum="0.12" Maximum="0.70" Value="0.36" TickFrequency="0.02" SmallChange="0.02" LargeChange="0.1" AutomationProperties.Name="기본 밝기"/>
                <TextBlock Text="세기 보정" FontWeight="SemiBold"/>
                <ComboBox x:Name="IntensityCombo" AutomationProperties.Name="세기 보정">
                  <ComboBoxItem Content="은은하게 · 0.62배" Tag="soft"/>
                  <ComboBoxItem Content="기본 · 1배" Tag="balanced"/>
                  <ComboBoxItem Content="강하게 · 1.35배" Tag="vivid"/>
                </ComboBox>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="빛 확산" FontWeight="SemiBold"/>
                <ComboBox x:Name="SpreadCombo" AutomationProperties.Name="빛 확산">
                  <ComboBoxItem Content="넓게 · 부드러운 가장자리" Tag="wide"/>
                  <ComboBoxItem Content="좁게 · 가장자리 집중" Tag="compact"/>
                </ComboBox>
                <TextBlock Text="중앙 보호" FontWeight="SemiBold"/>
                <ComboBox x:Name="ProtectCombo" AutomationProperties.Name="중앙 보호">
                  <ComboBoxItem Content="강하게 · 가독성 우선" Tag="strong"/>
                  <ComboBoxItem Content="기본" Tag="balanced"/>
                  <ComboBoxItem Content="약하게 · 색상 강조" Tag="light"/>
                </ComboBox>
                <CheckBox x:Name="MotionCheck" Content="조명 움직임 사용" AutomationProperties.Name="조명 움직임 사용"/>
                <TextBlock Text="조명 이동 시간" Style="{StaticResource Hint}"/>
                <TextBlock x:Name="SpeedValue" FontWeight="SemiBold"/>
                <Slider x:Name="SpeedSlider" Minimum="30" Maximum="160" Value="75" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="20" AutomationProperties.Name="조명 이동 시간"/>
                <TextBlock x:Name="LegacyText" Text="기존 값은 조작 전까지 유지합니다." Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="흐릿한 영상">
        <ScrollViewer>
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="흐릿한 영상" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="VideoEnabledCheck" Content="흐릿한 영상 사용" AutomationProperties.Name="흐릿한 영상 사용"/>
                <TextBlock Text="RGB와 함께 사용하거나 영상만 켤 수 있습니다. Chrome에서 ‘Windows로 전송’과 ‘흐릿한 영상도 전송’을 켜야 영상을 받을 수 있습니다." Style="{StaticResource Hint}"/>
                <TextBlock Text="영상 표시 범위" FontWeight="SemiBold"/>
                <ComboBox x:Name="CoverageCombo" AutomationProperties.Name="영상 표시 범위">
                  <ComboBoxItem Content="중앙 보호 설정 따름" Tag="follow"/>
                  <ComboBoxItem Content="좁게 · 가독성 우선" Tag="narrow"/>
                  <ComboBoxItem Content="기본" Tag="balanced"/>
                  <ComboBoxItem Content="넓게 · 영상 강조" Tag="wide"/>
                </ComboBox>
                <TextBlock Text="‘중앙 보호 설정 따름’은 RGB 조명 영역의 중앙 보호 값을 참조합니다." Style="{StaticResource Hint}"/>
                <TextBlock Text="영상 전환 효과" FontWeight="SemiBold"/>
                <ComboBox x:Name="TransitionCombo" AutomationProperties.Name="영상 전환 효과">
                  <ComboBoxItem Content="즉시 · 전환 없음" Tag="instant"/>
                  <ComboBoxItem Content="짧게 · 95ms (권장)" Tag="brief"/>
                  <ComboBoxItem Content="천천히 · 310ms" Tag="cinematic"/>
                </ComboBox>
                <TextBlock Text="전환 효과는 프레임 사이의 표현입니다. 영상 갱신 속도나 Chrome 성능 모드를 바꾸지 않습니다." Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="단축키">
        <ScrollViewer>
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="전역 단축키" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="HotkeyEnabledCheck" Content="전역 단축키 사용" AutomationProperties.Name="전역 단축키 사용"/>
                <TextBlock Text="통합 효과 일시정지 / 재개" Style="{StaticResource Hint}"/>
                <TextBox x:Name="HotkeyCombinationBox" AutomationProperties.Name="전역 단축키 조합" FontSize="16" Padding="10" Margin="0,8,0,8" MaxLength="64"/>
                <TextBlock Text="조합을 글자로 입력하세요. 추천: Ctrl+Alt+Shift+P. Ctrl 또는 Alt와 A-Z, 0-9, F1-F11 중 키 하나를 조합합니다. Shift도 추가할 수 있습니다." Style="{StaticResource Hint}"/>
                <TextBlock Text="Windows 키, F12, F4와 시스템 예약 키, 보조키 없는 단일 키는 사용할 수 없습니다. 처음에는 비활성입니다. 아래 적용 및 저장을 누르면 이전 조합을 해제하고 새 조합을 등록합니다." Style="{StaticResource Hint}"/>
                <TextBlock x:Name="HotkeyStatusText" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="RetryHotkeyButton" Content="저장된 단축키 다시 등록" HorizontalAlignment="Left"/>
                <TextBlock Text="등록됨은 Windows 키 등록 결과입니다. 효과의 전체 적용 여부는 트레이와 Chrome 팝업에서 확인하세요. 설정창과 팝업을 닫아도 Desktop 실행 중에는 동작하며, 원본 영상·소리와 개별 OFF 설정을 유지합니다." Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="연결">
        <ScrollViewer>
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Chrome 연결" Style="{StaticResource Heading}"/>
                <TextBlock Style="{StaticResource Hint}">
                  <Run Text="1. Desktop 앱을 실행한 상태로 둡니다."/><LineBreak/>
                  <Run Text="2. Chrome 확장 팝업에서 등록용 ID를 복사하고 아래에서 Chrome 연결을 등록합니다."/><LineBreak/>
                  <Run Text="3. 기존 페어링 코드를 복사해 확장의 ‘Windows 연결’에 붙여넣습니다."/><LineBreak/>
                  <Run Text="4. ‘Windows로 전송’을 켭니다. 영상도 쓰려면 ‘흐릿한 영상도 전송’을 켭니다."/>
                </TextBlock>
                <Button x:Name="NativeSetupButton" Content="Chrome 연결 등록" HorizontalAlignment="Left"/>
                <Button x:Name="CopyPairingButton" Content="페어링 코드 복사 (_C)" HorizontalAlignment="Left"/>
                <TextBlock Text="코드는 화면에 표시하지 않습니다. 복사한 코드는 공유하지 마세요." Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="로컬 수신 상태" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="ConnectionStatusText" Text="확인 대기" Style="{StaticResource Hint}"/>
                <Button x:Name="RefreshConnectionButton" Content="수신 상태 새로 고침" HorizontalAlignment="Left"/>
                <TextBlock Text="최근 파일 수신과 실제 Desktop 표시는 다릅니다. Chrome 전체 상태를 동기화한 결과는 아닙니다." Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="고급·진단">
        <ScrollViewer>
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="현재 실행 정보" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="PerformanceText" Text="확인 대기" Style="{StaticResource Hint}"/>
                <Button x:Name="RefreshAdvancedButton" Content="실행 정보 새로 고침" HorizontalAlignment="Left"/>
                <TextBlock x:Name="AdvancedText" Text="확인 대기" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="앱별 설정 요약" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="AppSummaryText" Text="확인 대기" Style="{StaticResource Hint}"/>
                <TextBlock Text="이 영역은 읽기 전용입니다. 앱별 값과 FPS 기본값은 여기서 변경하지 않습니다." Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="진단" Style="{StaticResource Heading}"/>
                <Button x:Name="BorderDiagnosticButton" Content="테두리 진단 · 10초" HorizontalAlignment="Left"/>
                <Button x:Name="BrightDiagnosticButton" Content="RGB 밝기 진단 · 10초" HorizontalAlignment="Left"/>
                <Button x:Name="FrameStatisticsButton" Content="영상 프레임 통계 · 최근 10초" HorizontalAlignment="Left"/>
                <TextBlock Text="진단도 일시정지와 출력 사용 설정을 따릅니다. 영상 Source 갱신률은 모니터 표시 FPS와 다릅니다." Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="SavedText" Text="저장된 설정입니다." MinHeight="42" LineHeight="21" AutomationProperties.LiveSetting="Polite"/>
      <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
        <Button x:Name="ReloadButton" Content="현재 값 다시 불러오기 (_L)" ToolTip="미적용 변경을 버리고 트레이의 최신 설정값을 불러옵니다."/>
        <Button x:Name="ApplyButton" Content="적용 및 저장 (_A)" FontWeight="SemiBold" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" IsEnabled="False"/>
        <Button x:Name="CloseButton" Content="창 닫기 (_X)" Margin="0,4,0,4"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
