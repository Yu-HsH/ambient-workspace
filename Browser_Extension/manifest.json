{
  "manifest_version": 3,
  "name": "Ambient Workspace",
  "version": "1.0.0",
  "version_name": "1.0.0-rc.1",
  "description": "Shared capture for YouTube, web ambient backgrounds, and desktop RGB and adjustable blurred video coverage",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "storage",
    "alarms",
    "scripting",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.notion.so/*",
    "https://notion.so/*",
    "https://www.notion.com/*",
    "https://notion.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://app.notion.com/*",
    "https://app.notion.so/*"
  ],
  "background": {
    "service_worker": "source/background.js"
  },
  "action": {
    "default_title": "Ambient Workspace",
    "default_popup": "source/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.notion.so/*",
        "https://notion.so/*",
        "https://www.notion.com/*",
        "https://notion.com/*",
        "https://app.notion.com/*",
        "https://app.notion.so/*"
      ],
      "js": [
        "source/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "source/youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-ambient": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Toggle ambient background"
    }
  },
  "key": ""
}
